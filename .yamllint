---
extends: default
ignore: |
  .terraform/
  ansible/collections/
rules:
  line-length:
    max: 140
  truthy:
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
